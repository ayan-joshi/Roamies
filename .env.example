# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the deployed app, used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the privacy/terms pages
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Email alerts (optional: alerts are skipped if any of these is empty) ---
# Supabase > Project Settings > API > service_role / secret key. SERVER ONLY, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# resend.com > API Keys
RESEND_API_KEY=
# Must use a domain verified in Resend
EMAIL_FROM=Roamies <hello@your-domain.in>
